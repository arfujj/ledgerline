# Copy to .env. Never commit .env.
# Set ONE of these. Anthropic direct is used if present; otherwise OpenRouter.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# auto | anthropic | openrouter
LEDGERLINE_LLM_PROVIDER=auto

# cheap = Claude Haiku 5.5 everywhere (default). quality = Claude Opus 5.5 for engagements (opt-in).
LEDGERLINE_MODEL_PROFILE=cheap

# Hard spend caps in USD. Calls that would exceed them raise BudgetExceeded.
LEDGERLINE_MAX_USD_PER_RUN=1.00
LEDGERLINE_MAX_USD_PER_DAY=5.00
LEDGERLINE_LLM_CACHE_ENABLED=true

LEDGERLINE_QDRANT_URL=http://localhost:6333
LEDGERLINE_NEO4J_URI=bolt://localhost:7687
LEDGERLINE_NEO4J_USER=neo4j
LEDGERLINE_NEO4J_PASSWORD=ledgerline-dev
LEDGERLINE_POSTGRES_DSN=postgresql+psycopg://ledgerline:ledgerline@localhost:55432/ledgerline
